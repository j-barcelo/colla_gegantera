# http://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# Frontend: TypeScript, JavaScript, Vue, SCSS, CSS, JSON, Markdown, YAML
[*.{js,jsx,ts,tsx,vue,scss,css,json,md,yml,yaml,html}]
indent_size = 2

[*.ts]
quote_type = single

# Backend: PHP (Estàndard PSR-12 / Laravel)
[*.php]
indent_size = 4
